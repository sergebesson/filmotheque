{
	"name": "@sbesson/filmotheque",
	"version": "1.4.14",
	"description": "Présentation de mes films",
	"main": "index.js",
	"scripts": {
		"test": "npm run build && npm run test:client",
		"client:install": "npm --prefix www ci",
		"build": "npm --prefix www run build",
		"build:watch": "npm --prefix www run build:watch",
		"test:client": "npm --prefix www test --",
		"typecheck:search": "npm --prefix www run typecheck:search",
		"prestart": "npm run build",
		"start": "URL_SERVER=localhost node index.js",
		"prestart:ip": "npm run build",
		"start:ip": "URL_SERVER=192.168.1.54 HOST=192.168.1.54 node index.js",
		"lint": "eslint '*.js' 'server/**/*.js' 'scripts/**/*.js' && npm --prefix www run lint",
		"lint:fix": "eslint '*.js' 'server/**/*.js' 'scripts/**/*.js' --fix && npm --prefix www run lint -- --fix"
	},
	"bin": {
		"migration_users": "scripts/migration_users.js"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/sergebesson/filmotheque.git"
	},
	"author": "Serge BESSON <serge@famille-besson.com>",
	"license": "GPL-3.0",
	"bugs": {
		"url": "git+ssh://git@github.com/sergebesson/filmotheque/issues"
	},
	"homepage": "git+ssh://git@github.com/sergebesson/filmotheque#readme",
	"dependencies": {
		"@sbesson/configuration-loader": "^1.0.1",
		"@sbesson/json-db": "^1.0.3",
		"compression": "^1.7.4",
		"decamelize-keys": "^1.1.1",
		"express": "^4.18.2",
		"express-basic-auth": "^1.2.0",
		"express-openapi-validator": "^4.13.8",
		"fast-glob": "^3.2.12",
		"lodash": "^4.17.19",
		"markdown-it": "^14.3.3",
		"require-glob": "^4.1.0",
		"require-yml": "^2.0.0",
		"serve-favicon": "^2.5.0",
		"swagger-parser": "^10.0.3",
		"swagger-ui-express": "^4.6.0",
		"traverse": "^0.6.7",
		"winston": "^3.8.2",
		"yargs": "^17.6.2"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"eslint": "10.15.0",
		"eslint-plugin-n": "18.5.0",
		"globals": "13.24.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
